+/// Rejects `model_provider_routes` entries that name a provider the config does not define.
+fn validate_model_provider_routes(
+    model_provider_routes: &HashMap<String, String>,
+    model_providers: &HashMap<String, ModelProviderInfo>,
+) -> std::io::Result<()> {
