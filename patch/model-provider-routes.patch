+//! Verifies that a model listed in `model_provider_routes` runs on the provider that serves it
+//! and that a session which is already pinned to a provider cannot switch providers.
+
+use anyhow::Result;
+use app_test_support::MockResponsesConfig;
+use app_test_support::TestAppServer;
+use app_test_support::create_fake_rollout;
+use codex_app_server_protocol::RequestId;
+use codex_app_server_protocol::ThreadSettingsUpdateParams;
+use codex_app_server_protocol::ThreadStartParams;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use tempfile::TempDir;
+use wiremock::MockServer;
+
+const INVALID_REQUEST_ERROR_CODE: i64 = -32600;
+
+/// Config that pins `deepseek-flash` to a second provider next to the default mock provider.
+fn routed_model_provider_config(deepseek_uri: &str) -> String {
+    format!(
+        r#"
+[model_providers.deepseek]
+name = "DeepSeek"
+base_url = "{deepseek_uri}/v1"
+wire_api = "responses"
+
+[model_provider_routes]
+deepseek-flash = "deepseek"
+"#
+    )
+}
+
+async fn routed_test_server() -> Result<(MockServer, TempDir, TestAppServer)> {
+    routed_test_server_with_default_model("mock-model").await
+}
+
+/// Same as [`routed_test_server`], but the config's own default model is the routed one.
+///
+/// `create_thread` delegations have this shape: the desktop client starts the delegated thread
+/// without naming a model, so the config default decides which model the session runs, and the
+/// route has to follow that decision.
+async fn routed_test_server_with_default_model(
+    default_model: &str,
+) -> Result<(MockServer, TempDir, TestAppServer)> {
+    let default_provider = MockServer::start().await;
+    let deepseek = MockServer::start().await;
+    let home = TempDir::new()?;
+    MockResponsesConfig::new(&default_provider.uri())
+        .with_model(default_model)
+        .with_extra_config(&routed_model_provider_config(&deepseek.uri()))
+        .write(home.path())?;
+    let server = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized()
+        .await?;
+    Ok((deepseek, home, server))
+}
