+/// The reported provider must never contradict `model_provider_routes`: naming a provider that the
+/// routing table routes elsewhere makes app-server reject the thread outright.
+///
+/// Each case configures `model_provider` (or omits it), a model, and the provider that
+/// `thread/start` is expected to report.
+#[tokio::test]
+async fn thread_start_defers_to_the_routing_table_over_the_built_in_default() {
+    assert_reported_provider(
+        /*configured_provider*/ None,
+        "deepseek-flash",
+        /*expected_provider*/ None,
+    )
+    .await;
+}
+
+#[tokio::test]
+async fn thread_start_keeps_a_configured_provider_that_agrees_with_the_route() {
+    assert_reported_provider(
+        /*configured_provider*/ Some("deepseek"),
+        "deepseek-flash",
+        /*expected_provider*/ Some("deepseek"),
+    )
+    .await;
+}
+
+#[tokio::test]
+async fn thread_start_keeps_a_configured_provider_for_an_unrouted_model() {
+    assert_reported_provider(
+        /*configured_provider*/ Some("openai"),
+        "gpt-5.5",
+        /*expected_provider*/ Some("openai"),
+    )
+    .await;
+}
+
+async fn assert_reported_provider(
+    configured_provider: Option<&str>,
+    model: &str,
+    expected_provider: Option<&str>,
+) {
+    let codex_home = tempdir().expect("create temp codex home");
+    let cwd = tempdir().expect("create temp cwd");
+    let configured_provider = configured_provider
+        .map(|provider| format!("model_provider = \"{provider}\"\n"))
+        .unwrap_or_default();
+    std::fs::write(
+        codex_home.path().join("config.toml"),
+        format!(
+            r#"{configured_provider}model = "{model}"
+
+[model_providers.deepseek]
+name = "DeepSeek"
+base_url = "http://127.0.0.1:9"
+wire_api = "responses"
+requires_openai_auth = false
+
+[model_provider_routes]
+"deepseek-flash" = "deepseek"
+"#,
+        ),
+    )
+    .expect("write config");
+    let config = ConfigBuilder::default()
+        .loader_overrides(LoaderOverrides::without_managed_config_for_tests())
+        .codex_home(codex_home.path().to_path_buf())
+        .fallback_cwd(Some(cwd.path().to_path_buf()))
+        .build()
+        .await
+        .expect("build config with a routed model");
+
+    assert_eq!(
+        thread_start_params_from_config(&config, &ThreadSource::User).model_provider,
+        expected_provider.map(str::to_string)
+    );
+}
