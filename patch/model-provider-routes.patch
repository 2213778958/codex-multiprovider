+/// Picks the model provider to report to app-server, mirroring the desktop client.
+///
+/// The resolved provider is only a real choice when it agrees with `model_provider_routes`. When it
+/// disagrees, the value is the configured default (or the built-in `openai` fallback) and naming it
+/// would make app-server reject the thread for running a routed model on the wrong provider. Omitting
+/// it lets the routing table decide, exactly as a client that never sends a provider does.
+fn requested_model_provider(config: &Config) -> Option<String> {
+    let provider_id = config.model_provider_id.as_str();
+    let routed_provider = config
+        .model
+        .as_deref()
+        .and_then(|model| config.model_provider_routes.get(model))
+        .map(String::as_str);
+    match routed_provider {
+        Some(routed_provider) if routed_provider != provider_id => None,
+        Some(_) | None => Some(provider_id.to_string()),
+    }
+}
