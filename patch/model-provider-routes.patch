+const WAKE_CHILD_PROMPT: &str = "child: finish the wake probe";
+const WAKE_CHILD_ANSWER: &str = "wake probe child finished";
+const WAKE_SPAWN_CALL_ID: &str = "wake-probe-spawn";
+const WAKE_COMPLETION_TEXT: &str = concat!(
+    "Message Type: FINAL_ANSWER\n",
+    "Task name: /root\n",
+    "Sender: /root/wake_probe\n",
+    "Payload:\n",
+    "wake probe child finished"
+);
