+++ b/codex-rs/app-server/tests/suite/v2/model_provider_routing_tests.rs
@@ -0,0 +1,227 @@
+//! Verifies that a model listed in `model_provider_routes` runs on the provider that serves it
+//! and that a session which is already pinned to a provider cannot switch providers.
+
+use anyhow::Result;
+use app_test_support::MockResponsesConfig;
+use app_test_support::TestAppServer;
+use app_test_support::create_fake_rollout;
+use codex_app_server_protocol::RequestId;
+use codex_app_server_protocol::ThreadSettingsUpdateParams;
+use codex_app_server_protocol::ThreadStartParams;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use tempfile::TempDir;
+use wiremock::MockServer;
+
+const INVALID_REQUEST_ERROR_CODE: i64 = -32600;
+
+/// Config that pins `deepseek-flash` to a second provider next to the default mock provider.
+fn routed_model_provider_config(deepseek_uri: &str) -> String {
+    format!(
+        r#"
+[model_providers.deepseek]
+name = "DeepSeek"
+base_url = "{deepseek_uri}/v1"
+wire_api = "responses"
+
+[model_provider_routes]
+deepseek-flash = "deepseek"
+"#
+    )
+}
+
+async fn routed_test_server() -> Result<(MockServer, TempDir, TestAppServer)> {
+    routed_test_server_with_default_model("mock-model").await
+}
+
+/// Same as [`routed_test_server`], but the config's own default model is the routed one.
+///
+/// `create_thread` delegations have this shape: the desktop client starts the delegated thread
+/// without naming a model, so the config default decides which model the session runs, and the
+/// route has to follow that decision.
+async fn routed_test_server_with_default_model(
+    default_model: &str,
+) -> Result<(MockServer, TempDir, TestAppServer)> {
+    let default_provider = MockServer::start().await;
+    let deepseek = MockServer::start().await;
+    let home = TempDir::new()?;
+    MockResponsesConfig::new(&default_provider.uri())
+        .with_model(default_model)
+        .with_extra_config(&routed_model_provider_config(&deepseek.uri()))
+        .write(home.path())?;
+    let server = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized()
+        .await?;
+    Ok((deepseek, home, server))
+}
+
+#[tokio::test]
+async fn thread_start_routes_a_configured_model_to_its_provider() -> Result<()> {
+    let (_deepseek, _home, mut server) = routed_test_server().await?;
+
+    let started = server
+        .start_thread(ThreadStartParams {
+            model: Some("deepseek-flash".to_string()),
+            ..Default::default()
+        })
+        .await?;
+
+    assert_eq!(started.model, "deepseek-flash");
+    assert_eq!(started.model_provider, "deepseek");
+    Ok(())
+}
+
+#[tokio::test]
+async fn thread_start_routes_the_config_default_model_when_the_request_names_none() -> Result<()> {
+    let (_deepseek, _home, mut server) =
+        routed_test_server_with_default_model("deepseek-flash").await?;
+
+    let started = server.start_thread(ThreadStartParams::default()).await?;
+
+    assert_eq!(started.model, "deepseek-flash");
+    assert_eq!(started.model_provider, "deepseek");
+    Ok(())
+}
+
+#[tokio::test]
+async fn thread_start_rejects_a_model_requested_on_another_provider() -> Result<()> {
+    let (_deepseek, _home, mut server) = routed_test_server().await?;
+
+    let id = server
+        .send_raw_request(
+            "thread/start",
+            Some(json!({
+                "model": "deepseek-flash",
+                "modelProvider": "mock_provider",
+            })),
+        )
+        .await?;
+    let error = server
+        .read_stream_until_error_message(RequestId::Integer(id))
+        .await?;
+
+    assert_eq!(error.error.code, INVALID_REQUEST_ERROR_CODE);
+    assert_eq!(
+        error.error.message,
+        "model `deepseek-flash` is routed to model provider `deepseek` and cannot run on `mock_provider`"
+    );
+    Ok(())
+}
+
+#[tokio::test]
+async fn thread_start_keeps_the_default_provider_for_unrouted_models() -> Result<()> {
+    let (_deepseek, _home, mut server) = routed_test_server().await?;
+
+    let started = server
+        .start_thread(ThreadStartParams {
+            model: Some("mock-model".to_string()),
+            ..Default::default()
+        })
+        .await?;
+
+    assert_eq!(started.model, "mock-model");
+    assert_eq!(started.model_provider, "mock_provider");
+    Ok(())
+}
+
+#[tokio::test]
+async fn thread_resume_rejects_a_model_routed_to_another_provider() -> Result<()> {
+    let (_deepseek, home, mut server) = routed_test_server().await?;
+    let thread_id = create_fake_rollout(
+        home.path(),
+        "2025-05-07T12-00-00",
+        "2025-05-07T12:00:00Z",
+        "routing resume",
+        Some("mock_provider"),
+        /*git_info*/ None,
+    )?;
+
+    let id = server
+        .send_raw_request(
+            "thread/resume",
+            Some(json!({
+                "threadId": thread_id,
+                "model": "deepseek-flash",
+            })),
+        )
+        .await?;
+    let error = server
+        .read_stream_until_error_message(RequestId::Integer(id))
+        .await?;
+
+    assert_eq!(error.error.code, INVALID_REQUEST_ERROR_CODE);
+    assert_eq!(
+        error.error.message,
+        "model `deepseek-flash` is routed to model provider `deepseek` and cannot run on `mock_provider`"
+    );
+    Ok(())
+}
+
+#[tokio::test]
+async fn thread_resume_without_a_model_override_keeps_the_pinned_provider() -> Result<()> {
+    let (_deepseek, home, mut server) = routed_test_server().await?;
+    let thread_id = create_fake_rollout(
+        home.path(),
+        "2025-05-07T12-00-01",
+        "2025-05-07T12:00:01Z",
+        "pinned resume",
+        Some("mock_provider"),
+        /*git_info*/ None,
+    )?;
+
+    let id = server
+        .send_raw_request("thread/resume", Some(json!({ "threadId": thread_id })))
+        .await?;
+    let resumed: codex_app_server_protocol::ThreadResumeResponse = server.read_response(id).await?;
+
+    assert_eq!(resumed.model_provider, "mock_provider");
+    Ok(())
+}
+
+#[tokio::test]
+async fn thread_settings_update_rejects_a_model_routed_to_another_provider() -> Result<()> {
+    let (_deepseek, _home, mut server) = routed_test_server().await?;
+    let started = server.start_thread(ThreadStartParams::default()).await?;
+
+    let id = server
+        .send_raw_request(
+            "thread/settings/update",
+            Some(json!({
+                "threadId": started.thread.id,
+                "model": "deepseek-flash",
+            })),
+        )
+        .await?;
+    let error = server
+        .read_stream_until_error_message(RequestId::Integer(id))
+        .await?;
+
+    assert_eq!(error.error.code, INVALID_REQUEST_ERROR_CODE);
+    assert_eq!(
+        error.error.message,
+        "model `deepseek-flash` is routed to model provider `deepseek` and cannot run on `mock_provider`"
+    );
+    Ok(())
+}
+
+#[tokio::test]
+async fn thread_settings_update_accepts_an_unrouted_model() -> Result<()> {
+    let (_deepseek, _home, mut server) = routed_test_server().await?;
+    let started = server.start_thread(ThreadStartParams::default()).await?;
+
+    let _: codex_app_server_protocol::ThreadSettingsUpdateResponse = server
+        .request(
+            |request_id| codex_app_server_protocol::ClientRequest::ThreadSettingsUpdate {
+                request_id,
+                params: ThreadSettingsUpdateParams {
+                    thread_id: started.thread.id.clone(),
+                    model: Some("mock-model".to_string()),
+                    ..Default::default()
+                },
+            },
+        )
+        .await?;
+
+    Ok(())
+}
