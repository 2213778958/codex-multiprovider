+        |req: &wiremock::Request| body_contains(req, TURN_1_PROMPT),
+        sse(vec![
+            ev_response_created("resp-wake-parent-1"),
+            ev_function_call_with_namespace(
+                WAKE_SPAWN_CALL_ID,
+                MULTI_AGENT_V2_NAMESPACE,
+                "spawn_agent",
+                &spawn_args,
+            ),
+            ev_completed("resp-wake-parent-1"),
+        ]),
+    )
+    .await;
+    // The parent turn keeps running only until the spawn result comes back, so this mock ends the
+    // parent's first turn and leaves no other responder while the child is still working.
+    let parent_followup_log = mount_sse_once_match(
+        &server,
+        |req: &wiremock::Request| {
+            request_has_input_type(req, "function_call_output")
+                && body_contains(req, WAKE_SPAWN_CALL_ID)
+        },
+        sse(vec![
+            ev_response_created("resp-wake-parent-1b"),
+            ev_assistant_message("msg-wake-parent-1b", "parent waiting"),
+            ev_completed("resp-wake-parent-1b"),
+        ]),
+    )
+    .await;
+    let child_request_log = mount_sse_once_match(
+        &server,
+        |req: &wiremock::Request| body_contains(req, WAKE_CHILD_PROMPT),
+        sse(vec![
+            ev_response_created("resp-wake-child-1"),
+            ev_assistant_message("msg-wake-child-1", WAKE_CHILD_ANSWER),
+            ev_completed("resp-wake-child-1"),
+        ]),
+    )
+    .await;
+    // Only a wake-up turn can ask the model again after the parent's turn already ended.
+    let wake_request_log = mount_sse_once_match(
+        &server,
+        |req: &wiremock::Request| body_contains(req, WAKE_COMPLETION_TEXT),
+        sse(vec![
+            ev_response_created("resp-wake-parent-2"),
+            ev_assistant_message("msg-wake-parent-2", "parent resumed"),
+            ev_completed("resp-wake-parent-2"),
+        ]),
+    )
+    .await;
+
+    let test = test_codex()
+        .with_config(move |config| {
+            config
+                .features
+                .enable(Feature::Collab)
+                .expect("test config should allow feature update");
+            config
+                .features
+                .enable(Feature::MultiAgentV2)
+                .expect("test config should allow feature update");
+            config.model_provider.request_max_retries = Some(0);
+            config.model_provider.stream_max_retries = Some(0);
+            config.model_provider.supports_websockets = false;
+            config.agent_wake_parent_on_completion = wake_parent_on_completion;
+        })
+        .build_with_auto_env(&server)
+        .await?;
+
+    test.submit_turn(TURN_1_PROMPT).await?;
+    let child_request = wait_for_requests(&child_request_log)
+        .await?
+        .pop()
+        .expect("spawned child should send its own request");
+    assert!(child_request.body_contains_text(WAKE_CHILD_PROMPT));
+    let _ = wait_for_requests(&parent_followup_log).await?;
+
+    let wake_request = wait_for_request_with_text(
+        &wake_request_log,
+        WAKE_COMPLETION_TEXT,
+        Duration::from_secs(if wake_parent_on_completion { 10 } else { 6 }),
+    )
+    .await?;
+
+    if wake_parent_on_completion {
+        let wake_request = wake_request.expect("completed child should wake the idle parent");
+        assert_eq!(
+            strip_response_item_ids_from_json(strip_metadata_from_json(Value::Array(
+                wake_request.inputs_of_type("agent_message"),
+            ))),
+            Value::Array(vec![json!({
+                "type": "agent_message",
+                "author": "/root/wake_probe",
+                "recipient": "/root",
+                "content": [{
+                    "type": "input_text",
+                    "text": WAKE_COMPLETION_TEXT,
+                }],
+            })])
+        );
+    } else {
+        assert!(
+            wake_request.is_none(),
+            "the disabled wake must not resume the idle parent after the child completes"
+        );
+    }
+
+    Ok(())
+}
