+#[test_case(true; "wakes the idle parent")]
+#[test_case(false; "keeps the idle parent asleep")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn completed_child_wakes_idle_parent(wake_parent_on_completion: bool) -> Result<()> {
