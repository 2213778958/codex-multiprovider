+    /// Resolves the model provider for a requested model and rejects cross-provider selections.
+    ///
+    /// The desktop client picks a model without naming its provider, so `model_provider_routes`
+    /// from config is the routing source of truth. `pinned_provider` is the provider a session has
+    /// already committed to; a session may only run models routed to that provider.
+    fn resolve_thread_model_provider(
+        &self,
+        pinned_provider: Option<&str>,
+        model: Option<&str>,
+        requested_provider: Option<&str>,
+    ) -> Result<Option<String>, JSONRPCErrorError> {
+        if let (Some(pinned_provider), Some(requested_provider)) =
+            (pinned_provider, requested_provider)
+            && pinned_provider != requested_provider
+        {
+            return Err(invalid_request(format!(
+                "session is pinned to model provider `{pinned_provider}` and cannot switch to `{requested_provider}`"
+            )));
+        }
+        let Some(model) = model else {
+            return Ok(requested_provider.or(pinned_provider).map(str::to_string));
+        };
+        let routed_provider = self
+            .config
+            .model_provider_routes
+            .get(model)
+            .map(String::as_str);
+        if let (Some(requested_provider), Some(routed_provider)) =
+            (requested_provider, routed_provider)
+            && requested_provider != routed_provider
+        {
+            return Err(invalid_request(format!(
+                "model `{model}` is routed to model provider `{routed_provider}` and cannot run on `{requested_provider}`"
+            )));
+        }
+        if let Some(pinned_provider) = pinned_provider {
+            ensure_model_routed_to_provider(
+                &self.config.model_provider_routes,
+                pinned_provider,
+                model,
+            )?;
+        }
+        Ok(routed_provider
+            .or(requested_provider)
+            .or(pinned_provider)
+            .map(str::to_string))
+    }
