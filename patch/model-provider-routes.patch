+/// Rejects `model_provider_routes` entries that name a provider the config does not define.
+fn validate_model_provider_routes(
+    model_provider_routes: &HashMap<String, String>,
+    model_providers: &HashMap<String, ModelProviderInfo>,
+) -> std::io::Result<()> {
+    for (model, provider_id) in model_provider_routes {
+        if !model_providers.contains_key(provider_id) {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::NotFound,
+                format!(
+                    "model_provider_routes.{model} references unknown model provider `{provider_id}`"
+                ),
+            ));
+        }
+    }
+    Ok(())
+}
