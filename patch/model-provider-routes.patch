+/// Rejects a model that config routes to a provider other than the one a session is pinned to.
+///
+/// Models absent from `model_provider_routes` are unrestricted, so configurations that do not
+/// declare routes keep their previous behavior.
+pub(crate) fn ensure_model_routed_to_provider(
+    model_provider_routes: &HashMap<String, String>,
+    provider_id: &str,
+    model: &str,
+) -> Result<(), JSONRPCErrorError> {
+    if let Some(routed_provider) = model_provider_routes.get(model)
+        && routed_provider != provider_id
+    {
+        return Err(invalid_request(format!(
+            "model `{model}` is routed to model provider `{routed_provider}` and cannot run on `{provider_id}`"
+        )));
+    }
+    Ok(())
+}
